# Docker Compose ports
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Frontend
VITE_API_URL=/backend
VITE_N8N_ATS_WEBHOOK_URL=http://localhost:5678/webhook/overkill/analyse-cv-ats

# Symfony
APP_ENV=dev
APP_SECRET=replace_with_local_app_secret
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
CORS_ALLOW_ORIGIN=http://localhost:5173

# Neon PostgreSQL
POSTGRES_REMOTE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require&charset=utf8

# Mailtrap Email Sandbox
MAILER_DSN=smtp://username:password@sandbox.smtp.mailtrap.io:2525
CONTACT_RECIPIENT=contact@overkill.test
CONTACT_SENDER=no-reply@overkill.test
