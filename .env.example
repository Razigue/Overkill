# Docker Compose ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Frontend
VITE_API_URL=http://localhost:8000
VITE_N8N_ATS_WEBHOOK_URL=http://localhost:5678/webhook/overkill/analyse-cv-ats

# Symfony
APP_ENV=dev
APP_SECRET=replace_with_local_app_secret
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailtrap Email Sandbox
MAILER_DSN=smtp://username:password@sandbox.smtp.mailtrap.io:2525
CONTACT_RECIPIENT=contact@overkill.test
CONTACT_SENDER=no-reply@overkill.test

# Local PostgreSQL container
POSTGRES_DB=overkill
POSTGRES_USER=overkill_user
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Future optional remote PostgreSQL placeholders.
# Do not use these for the default local Docker setup.
POSTGRES_REMOTE_URL=replace_with_neon_symfony_database_url
